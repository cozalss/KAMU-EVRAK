# kamu-evrak — ortam değişkenleri örneği. Kopyala: cp .env.example .env
# GİZLİ ANAHTARLARI ASLA commit etme (.env .gitignore'da).

# --- LLM modu ---
# Pipeline her modda UÇTAN UCA çalışır; fark KALİTE'dedir (mock = taban, openai = gerçek doğruluk).
#   mock     : LLM çağrısı YOK. Sınıflandırma/çıkarım keyword+regex heuristik fallback'e düşer.
#              Anahtar GEREKMEZ → demo/CI/offline. docs/benchmark/scorecard.md skorları bu modun
#              TABAN (alt-sınır) ölçümüdür; gerçek LLM modu bu metrikleri yükseltir.
#   openai   : OpenAI bulut (gpt-4o / gpt-4o-mini). few-shot LLM JSON çıkarımı → gerçek doğruluk.
#              OPENAI_API_KEY ZORUNLU (yoksa kod güvenle mock'a düşer — patlamaz, sadece uyarır).
#   llamacpp : lokal Qwen GGUF (llama-cpp-python; offline/gizlilik). LLM_MODEL_PATH gerekir.
LLM_MODE=mock

# --- OpenAI (LLM_MODE=openai ve/veya bulut OCR için) ---
# Anahtar .env'de tutulur, ASLA commit edilmez (.gitignore'da). Tek komut ölçüm:
#   LLM_MODE=openai OPENAI_API_KEY=sk-... python scripts/run_llm_smoke.py
# OPENAI_API_KEY=sk-...
# LLM ana model — kod OPENAI_LLM_MODEL okur (default gpt-4o-mini; gpt-4o = en yüksek kalite).
# OPENAI_LLM_MODEL=gpt-4o-mini
# OpenAI vision-OCR modeli (OCR_PROVIDER=openai/auto için ayrı değişken).
# OPENAI_OCR_MODEL=gpt-4o-mini
# Azure/proxy/LiteLLM gateway override (default api.openai.com); SSRF için şema doğrulanır.
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- OCR ---
# OCR motoru: rapidocr (varsayılan, offline) | tesseract (binary gerekir) | qwen-vl (ağır)
OCR_ENGINE=rapidocr
# Görsel-OCR sağlayıcı: auto (anahtar varsa OpenAI vision) | openai | local
OCR_PROVIDER=local
OCR_TIMEOUT_S=30
OCR_PDF_MAX_PAGES=10
OCR_PDF_DPI=200

# --- API ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Mevzuat RAG (opsiyonel; uv sync --extra rag gerektirir) ---
# QDRANT_URL=http://localhost:6333
# REDIS_URL=redis://localhost:6379
# MEVZUAT_COLLECTION=kamu_evrak_mevzuat

# --- Üretim: model erişim bilgileri (ağırlık repoya YÜKLENMEZ — docs/07) ---
# BGE-M3, BERTurk, mT5-tr vb. HuggingFace üzerinden çekilir.
