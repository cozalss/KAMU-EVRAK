# kamu-evrak — ortam değişkenleri örneği. Kopyala: cp .env.example .env
# GİZLİ ANAHTARLARI ASLA commit etme (.env .gitignore'da).

# --- LLM modu ---
# mock     : LLM çağrısı yok (iskelet/CI; stub node'lar deterministik çalışır)
# openai   : OpenAI bulut (gpt-4o / gpt-4o-mini) — OPENAI_API_KEY gerekir
# llamacpp : lokal Qwen GGUF (llama-cpp-python; offline/gizlilik)
LLM_MODE=mock

# --- OpenAI (LLM_MODE=openai veya bulut OCR için) ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- OCR ---
# OCR motoru: rapidocr (varsayılan, offline) | tesseract (binary gerekir) | qwen-vl (ağır)
OCR_ENGINE=rapidocr
# Görsel-OCR sağlayıcı: auto (anahtar varsa OpenAI vision) | openai | local
OCR_PROVIDER=local
OCR_TIMEOUT_S=30
OCR_PDF_MAX_PAGES=10
OCR_PDF_DPI=200

# --- API ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Mevzuat RAG (opsiyonel; uv sync --extra rag gerektirir) ---
# QDRANT_URL=http://localhost:6333
# REDIS_URL=redis://localhost:6379
# MEVZUAT_COLLECTION=kamu_evrak_mevzuat

# --- Üretim: model erişim bilgileri (ağırlık repoya YÜKLENMEZ — docs/07) ---
# BGE-M3, BERTurk, mT5-tr vb. HuggingFace üzerinden çekilir.
