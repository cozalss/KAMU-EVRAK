# kamu-evrak — ortam değişkenleri örneği. Kopyala: cp .env.example .env
# GİZLİ ANAHTARLARI ASLA commit etme (.env .gitignore'da).

# --- LLM modu ---
# Pipeline her modda UÇTAN UCA çalışır; fark KALİTE'dedir (mock = taban, openai = gerçek doğruluk).
#   mock     : LLM çağrısı YOK → keyword/regex heuristik fallback. Anahtar GEREKMEZ (demo/CI/offline; skor tabanı).
#   openai   : OpenAI-uyumlu bulut API (DeepSeek ÖNERİLEN / OpenAI / Azure...). OPENAI_API_KEY zorunlu;
#              yoksa kod güvenle mock'a düşer (patlamaz). few-shot LLM JSON çıkarımı → gerçek doğruluk.
#   llamacpp : lokal Qwen GGUF (on-prem / gizlilik; veri kurumdan çıkmaz). LLM_MODEL_PATH gerekir.
LLM_MODE=mock

# --- Üretim sağlayıcı: DeepSeek (OpenAI-uyumlu, ÖNERİLEN) ---
# Neden: ucuz (V4 Flash $0.14/$0.28 per 1M — gpt-4o-mini'den de ucuz) + güçlü Türkçe (held-out ~gpt-4o seviyesi).
# Kod değişikliği YOK: OpenAI client'ı OPENAI_BASE_URL override ile DeepSeek'e bağlanır. Anahtar ASLA commit edilmez.
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_LLM_MODEL=deepseek-v4-flash    # DeepSeek-V4 Flash — sınıflandırma/çıkarım/özet/taslak
# UYARI (2026-07-24): eski adlar `deepseek-chat` / `deepseek-reasoner` API tarafından
# KALDIRILDI (HTTP 400). Geçerli adlar: deepseek-v4-flash | deepseek-v4-pro.
# Bu modeller REASONING üretir; düşünme token'ları max_tokens'tan düşer →
# LLM_DUSUNME_MARJI (varsayılan 700) node bütçelerine eklenir, yoksa cevap BOŞ döner.
# OPENAI_API_KEY=                        # DeepSeek anahtarını GERÇEK .env'e yapıştır

# --- Alternatif sağlayıcı: OpenAI ---
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_LLM_MODEL=gpt-4o-mini           # ucuz varsayılan; gpt-4o ~15-20× PAHALI (yalnız tek-seferlik artefakt ölçümü)
# OPENAI_API_KEY=sk-...
# OPENAI_OCR_MODEL=gpt-4o-mini           # vision-OCR modeli (yalnız OCR_PROVIDER=openai/auto)

# --- Sesli mod (chatbot TTS — asistan yanıtını sesli okur) ---
# DeepSeek'in TTS servisi YOK — bu yüzden BAĞIMSIZ bir anahtar (yukarıdaki OPENAI_API_KEY/
# OPENAI_BASE_URL DeepSeek'e işaret etse bile TTS her zaman gerçek api.openai.com'a gider,
# birbirini ETKİLEMEZ). Boş/tanımsızsa sesli mod sessizce devre dışı kalır (metin balonu
# normal görünür, hata verilmez) — deterministik-fallback deseniyle tutarlı.
# OPENAI_TTS_API_KEY=sk-...              # platform.openai.com — ayrı, gerçek OpenAI hesabı gerekir
# OPENAI_TTS_MODEL=gpt-4o-mini-tts       # steerable kuşak (prozodi yönlendirilebilir). tts-1 = eski/robotik
# OPENAI_TTS_VOICE=marin                 # yeni kuşak: marin|cedar|ash|sage|ballad|verse|coral|alloy|nova
#                                        # (marin/cedar YALNIZ gpt-4o-mini-tts'te; tts-1'de HTTP 400 → güvenli sese düşer)
# OPENAI_TTS_TALIMAT=                    # prozodi yönergesi (tempo/ton/nefes); boşsa Türkçe varsayılan
# SESLI_PERSONA_ADI=Kamu Evrak           # sesli asistanın adı (persona); istediğin adla değiştir

# --- OCR ---
# OCR motoru: rapidocr (varsayılan, offline) | tesseract (binary gerekir) | qwen-vl (ağır)
OCR_ENGINE=rapidocr
# Görsel-OCR sağlayıcı: auto (anahtar varsa OpenAI vision) | openai | local
OCR_PROVIDER=local
OCR_TIMEOUT_S=30
OCR_PDF_MAX_PAGES=10
OCR_PDF_DPI=200

# --- Gelişmiş node'lar (ENV-gated; hepsi VARSAYILAN KAPALI → baseline birebir korunur) ---
# Demo/jüri için aç; çoğu ek LLM çağrısı/model getirir (maliyet/ağırlık). Detay: agents/config.py.
# DECOMPOSE_ENABLED=1         # Çok-konulu evrak → alt-talepler (tür+birim+süre). VARSAYILAN AÇIK; =0 ile baseline.
# RISK_GUARD_ENABLED=1        # Risk bandı (trafik ışığı 🟢🟡🔴). VARSAYILAN AÇIK. HITL ile → koşullu onay (🟢 geç, 🟡🔴 dur).
# SELF_CONSISTENCY_N=3        # M2: N bağımsız sınıflandırma oyu; uzlaşı yoksa dürüst 'belirsiz'. N× LLM maliyeti.
# HITL_ENABLED=1              # Memur onay kapısı (interrupt → onayla/düzenle/reddet)
# RERANK_ENABLED=1            # Mevzuat BM25 top-N → cross-encoder rerank (rag extra gerekir)
# NLI_ENABLED=1               # Mevzuat ⊨ talep entailment grounding (model gerekir)
# CRAG_ENABLED=1              # Corrective-RAG: düşük retrieval güveninde öz-düzeltme
# CLARIFY_STOP_ENABLED=1      # Dur-ve-sor: kritik eksikte taslak üretmeden bilgi iste
# KARAR_GROUNDING_ENABLED=1   # (varsayılan AÇIK) Karar/inceleme uydurması vetosu: kaynakta
#                             #   karar yokken 'incelenmiştir/uygun bulunmuştur/reddedilmiştir'
#                             #   → deterministik KIRMIZI (HITL zorunlu). Yazı-türü sertleştirme.

# --- AI Bürokrasi Kurulu (taslak müzakeresi — TaslaklarView "Kurul") ---
# Kurul GERÇEK bir yakınsama döngüsüdür: açılış → çapraz eleştiri → DENETİM turu. Her turdan
# sonra öneriler deterministik çapalı-edit olarak uygulanır ve taslağın sinyalleri REVİZE METİN
# ÜZERİNDE yeniden ölçülür (verify + risk_guard); kurul ölçüme bakarak devam eder. Döngü şu üç
# koşuldan biriyle biter: itiraz 0 · yeni uygulanabilir edit yok · tur bütçesi doldu.
# ÖLÇÜLDÜ (2026-08-06, deepseek-v4-flash): tam müzakere ~100-170 sn, ~$0.006. Derinlik hızdan
# önce gelir — kurul opt-in'dir ve memur müzakereyi izler.
# KURUL_MUZAKERE_TURU=2         # LLM müzakere turu (1 = yalnız çapraz eleştiri; tavan 4)
# KURUL_TUR_TIMEOUT_S=120       # Tur başına süre. Node varsayılanı (20 sn) müzakereye YETMEZ:
#                               #   dar bütçede tur kesilip kurul sessizce deterministiğe düşer.
# KURUL_ACILIS_TIMEOUT_S=30     # Açılış turu (3 kısa pozisyon) — müzakere turundan kısa.

# --- Onay yetkisi (§13: taslak-oluşturma ≠ onaylama) ---
# ONAY_MIN_ROL=memur          # /onayla için asgari rol. Varsayılan 'memur' = tek-rol demo akışı.
#                             #   'yetkili' → taslak (memur) ile ONAYLAMA (yetkili+) ayrılır.

# --- Kurum kimliği (antet: T.C. / idare / birim) — kurumun VARSAYILAN adı ---
# Boş bırakılırsa jenerik "KAMU KURUMU / YAZI İŞLERİ BİRİMİ" yer tutucusu KORUNUR (baseline).
# Doldurulunca kurum yazılır ve grounding otomatik hizalanır (uydurma sayılmaz).
# ÖNERİ: SENTETİK/kurgu bir kurum adı kullan (CLAUDE.md §6.5) — gerçek bir kamu kurumunu
# temsil ettiğinizi iddia etmeyin. Kurgu ad, data/teskilat/ route-doğrulama korpusundaki
# (139 gerçek kurum) hiçbir isimle ÇAKIŞMAMALI. Örnek — gerçek bir Türkiye ili/ilçesi DEĞİLDİR:
# KURUM_ADI=ÖRNEKŞEHİR BELEDİYE BAŞKANLIĞI
# KURUM_BIRIM=Yazı İşleri Müdürlüğü
# NOT: bu yalnız FALLBACK'tir. Belge açıkça bir kuruma hitaben yazılmışsa (yönelme-ekli,
# ör. "...BAŞKANLIĞINA"; yargı hariç) antet OTOMATİK o kurumu kullanır — sormadan, uyarı
# vermeden ("biz belgeye göre hareket ediyoruz"; agents/kurum_kimlik.py: efektif_idare_adi).
# Belge açık bir hitap taşımıyorsa (nominatif başlık/hiç kurum yok) buradaki değer kullanılır.
# İstek-bazlı "aktif kurum" override'ı (eski ProcessRequest.aktif_kurum alanı + frontend
# "Aktif kurum" ayarı) 6 Ağu 2026'da KALDIRILDI — kurum kimliği yalnız belgeden ya da buradan.

# --- API ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# İşlenen evrak/pipeline sonuçlarını PostgreSQL'e yaz (gerçek DATABASE_URL gerekir;
# placeholder URL ile açık bırakma → her istekte db_persist_hata log gürültüsü).
DB_PERSIST=0

# --- Kimlik doğrulama (JWT) ---
# Boş bırakılırsa her açılışta GEÇİCİ rastgele secret üretilir (demo çalışır ama
# oturumlar restart'ta düşer). Kalıcı oturum + üretim için doldur: `openssl rand -hex 32`
# NOT: APP_ENV=production'da geçici fallback KAPALI — bu değer (ve DATABASE_URL) zorunlu.
AUTH_JWT_SECRET=

# --- Telefonla evrak yükleme (mobil QR) — LAN erişimi ---
# Standart komut `uv run main.py` .env OLMASA BİLE 0.0.0.0:8000'e bağlanır (varsayılan
# kodda) → telefon, bilgisayarla AYNI Wi-Fi/hotspot ağındaysa QR ile evrak yükler,
# ekstra adım yok. Bu değişken yalnız EZMEK içindir:
#   UVICORN_HOST=127.0.0.1  → güvenilmeyen ağda yalnız localhost'tan erişim
#   UVICORN_PORT=8000       → port değişikliği
# Windows'ta ilk bağlantıda güvenlik duvarı izin penceresi çıkabilir ("İzin Ver" yeterli);
# çıkmaz/bağlanamazsa bkz. scripts/demo-mobil.ps1 (firewall kuralını da otomatik ekler).
# UVICORN_HOST=127.0.0.1

# --- Mevzuat RAG (opsiyonel; uv sync --extra rag gerektirir) ---
# QDRANT_URL=http://localhost:6333
# REDIS_URL=redis://localhost:6379
# MEVZUAT_COLLECTION=kamu_evrak_mevzuat

# --- Üretim: model erişim bilgileri (ağırlık repoya YÜKLENMEZ — docs/07) ---
# BGE-M3, BERTurk, mT5-tr vb. HuggingFace üzerinden çekilir.

# ============================================================
# Supabase / PostgreSQL (DB persistence — docs/database-schema.md)
# Supabase Dashboard'dan al; .env'e (gitignore'lu) gerçek değerleri yapıştır.
# ÖNEMLİ: özel karakter ($, boşluk, #, ! ...) içeren değerleri 'tek tırnak' içine al —
# tırnaksız özel karakter, uv --env-file gibi katı parser'ların DOSYANIN TAMAMINI
# sessizce atlamasına yol açabilir (uygulama python-dotenv ile yine okur ama uyumlu kal).
# ------------------------------------------------------------
# Uygulama (async/asyncpg, Transaction Pooler :6543; statement_cache_size=0)
DATABASE_URL=postgresql+asyncpg://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres
# Alembic migration/seed (sync/psycopg, Session Pooler :5432)
DATABASE_URL_SYNC=postgresql+psycopg://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres
# Dashboard → Project Settings → API
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_DB_PASSWORD=

# ============================================================
# HALKA AÇIK DEMO KORUMASI (docs: plan "canlı demo koruma katmanı")
# Bu blok YALNIZ internete açık demo dağıtımı içindir. Yerel geliştirmede ve CI'da
# DEMO_KORUMA tanımsız bırakılır → tüm katman devre dışı, davranış bugünküyle bit-aynı.
#
# UYARI — İKİ AYRI BÜTÇE VARDIR: günlük en kötü hâl
#   DEMO_AZAMI_GUNLUK_USD  +  KESIF_AZAMI_HARCAMA_USD
# toplamıdır. İkisi ayrı defterde tutulur; birinin dolması diğerini kapatmaz.
# ------------------------------------------------------------
# Ana anahtar. Açıkken boot doğrulaması devreye girer ve GÜVENSİZ konfigürasyonda
# uygulama HİÇ BAŞLAMAZ (DB_PERSIST=1, SQL_ECHO=1, localhost CORS, tavansız bütçe...).
DEMO_KORUMA=1

# Günlük küresel para tavanı (USD). TANIMSIZ ya da bozuk → katman KAPALI (fail-closed),
# yani hiçbir ücretli istek geçmez. NOKTA kullanın: '0.50' doğru, '0,50' YANLIŞ.
DEMO_AZAMI_GUNLUK_USD=0.50

# Belge başına ÖNDEN düşülen rezervasyon. En kötü hâle (10 sayfalık taranmış PDF +
# imla düzeltme + ~20 pipeline çağrısı) göre seçilir; istek bitince gerçek token
# harcamasıyla mutabakat yapılır ve fark (negatif olabilir) deftere yazılır.
DEMO_BELGE_REZERVASYON_USD=0.03

# Günlük belge kotası — iki eksen. Ziyaretçi = imzalı çerez, ağ = IPv4 /24 (IPv6 /64).
# Çerez silen ziyaretçi ağ kovasına düşer; NAT arkasındaki ofis ise ayrı çerezlerle
# adil bölüşür (4 kişi × 3 = 12 = ağ tavanı).
DEMO_KOTA_BELGE_GUN=3
DEMO_KOTA_AG_GUN=12

# Ziyaretçi çerezi imza anahtarı. Verilmezse AUTH_JWT_SECRET'tan alan-ayrımıyla türer;
# o da yoksa süreç başına rastgele üretilir (restart'ta tüm çerezler geçersizleşir →
# herkes çerezsiz kovaya düşer, yani DAHA kısıtlayıcı). Üret: openssl rand -hex 32
DEMO_KOTA_SECRET=

# TEHLİKELİ KNOB — yalnız gerçekten önde ters vekil VARSA verin.
# 0 (varsayılan): X-Forwarded-For tamamen YOK SAYILIR. Tünel/CDN arkasında bu, tüm
# ziyaretçileri tek ağ kovasına düşürür (aşırı kısıtlayıcı = güvenli yön).
# >0: XFF listesinin SAĞINDAN n'inci alınır. Önde vekil yokken bu değeri vermek, sahte
# başlıkla sınırsız kimlik üretilmesine izin verir.
DEMO_GUVENILEN_PROXY_SAYISI=0

# Model fiyat ezmesi (USD / 1M girdi, USD / 1M çıktı). Varsayılanlar bilinçli olarak
# YÜKSEK tahminlerdir (fazla saymak bütçeyi erken kapatır — güvenli yön), fatura değil.
# DEMO_FIYAT_DEEPSEEK_V4_FLASH=0.30,1.20
# DEMO_FIYAT_DEEPSEEK_V4_PRO=1.00,4.00

# Demo modunda ZORUNLU olanlar (boot doğrulaması bunları arar):
#   APP_ENV=production          → /docs, /redoc, /openapi.json kapanır + HSTS açılır
#   CORS_ORIGINS=https://<alan> → localhost içeremez, boş olamaz
#   AUTH_JWT_SECRET=<64 hex>    → zorunlu
#   RATE_LIMIT_ENABLED=true     → kapatılamaz
#   DB_PERSIST ve SQL_ECHO      → AÇIK OLAMAZ (yabancı belgesi DB'ye/log'a yazılmaz)
#   WEB_CONCURRENCY=1 önerilir  → kota sözlüğü worker başınadır, >1 kotayı çarpar

# Frontend (Vite — build anında gömülür): onam kapısını ve kota sayacını açar.
# VITE_DEMO_MODU=1

# PII log maskeleme kill-switch'i — VARSAYILAN AÇIK. Kapatmak bilinçli bir eylem olmalı;
# kapatılırsa TCKN/telefon/IBAN log'a HAM düşer.
# KE_LOG_PII_MASK=1
